# Neon Postgres (pooled connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Auth session secret (generate: openssl rand -base64 32)
AUTH_SECRET="change-me"

# App URL (Vercel will set VERCEL_URL; set explicitly in prod if preferred)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# CQC API (free key from https://api-portal.service.nhs.uk/ or CQC developer portal)
CQC_API_KEY=""
CQC_API_BASE="https://api.service.cqc.org.uk"

# Companies House API key (https://developer.company-information.service.gov.uk/)
COMPANIES_HOUSE_API_KEY=""

# Cron endpoint auth — Vercel Cron sends this as Bearer token
# Generate: openssl rand -base64 32
CRON_SECRET=""

# Outbound email for campaigns (SMTP)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ScanVault <hello@scanvault.co.uk>"
