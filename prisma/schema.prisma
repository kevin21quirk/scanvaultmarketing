generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// Auth & users
// ------------------------------------------------------------------

enum Role {
  ADMIN
  USER
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  name         String
  passwordHash String
  role         Role        @default(USER)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  leads        Lead[]      @relation("LeadAssignee")
  activities   Activity[]
  tasks        Task[]      @relation("TaskAssignee")
  importJobs   ImportJob[]
}

// ------------------------------------------------------------------
// Pipeline
// ------------------------------------------------------------------

model PipelineStage {
  id        String  @id @default(cuid())
  name      String
  order     Int
  color     String  @default("#6B7280")
  isWon     Boolean @default(false)
  isLost    Boolean @default(false)
  isDefault Boolean @default(false)
  leads     Lead[]
}

// ------------------------------------------------------------------
// Leads (care homes / providers)
// ------------------------------------------------------------------

enum LeadStatus {
  NEW
  ACTIVE
  WON
  LOST
  ARCHIVED
}

enum LeadSource {
  MANUAL
  CQC
  COMPANIES_HOUSE
  CSV_IMPORT
  LINKEDIN_SALES_NAV
  WEB_SEARCH
  REFERRAL
  INBOUND
  OTHER
}

enum LeadType {
  CARE_HOME
  CARE_HOME_GROUP
  HOME_CARE
  SUPPORTED_LIVING
  HOSPICE
  NHS_TRUST
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Lead {
  id      String     @id @default(cuid())
  name    String
  akaName String?
  type    LeadType   @default(CARE_HOME)

  // Address
  addressLine1 String?
  addressLine2 String?
  town         String?
  county       String?
  postcode     String?
  region       String?
  country      String  @default("England")
  latitude     Float?
  longitude    Float?

  // Contact channels
  phone       String?
  email       String?
  website     String?
  linkedinUrl String?

  // Care-sector enrichment
  cqcLocationId  String?  @unique
  cqcProviderId  String?
  cqcProviderUrl String?
  cqcRating      String?
  cqcRatedAt     DateTime?
  beds           Int?
  careTypes      String[]
  providerName   String?
  companiesHouseNo String?
  localAuthority String?

  // CRM fields
  status          LeadStatus @default(NEW)
  stageId         String?
  stage           PipelineStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  source          LeadSource   @default(MANUAL)
  sourceDetail    String?
  score           Int          @default(0)
  priority        Priority     @default(MEDIUM)
  estimatedValue  Float?
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  notes           String?
  doNotContact    Boolean      @default(false)
  unsubscribed    Boolean      @default(false)

  assignedToId String?
  assignedTo   User?   @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts             Contact[]
  activities           Activity[]
  tasks                Task[]
  tags                 LeadTag[]
  campaignMemberships  CampaignLead[]
  sequenceEnrollments  SequenceEnrollment[]
  importJobs           ImportJobLead[]

  @@index([status])
  @@index([stageId])
  @@index([postcode])
  @@index([town])
  @@index([county])
  @@index([region])
  @@index([name])
  @@index([source])
  @@index([nextFollowUpAt])
  @@index([createdAt])
}

// ------------------------------------------------------------------
// Contacts (people at a lead)
// ------------------------------------------------------------------

model Contact {
  id        String  @id @default(cuid())
  leadId    String
  lead      Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String?
  jobTitle  String?
  email     String?
  phone     String?
  mobile    String?
  linkedIn  String?
  isPrimary Boolean @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities Activity[]
  tasks      Task[]

  @@index([leadId])
  @@index([email])
}

// ------------------------------------------------------------------
// Activities (interaction log)
// ------------------------------------------------------------------

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  SMS
  LETTER
  LINKEDIN
  WEBSITE_VISIT
  STAGE_CHANGE
  IMPORT
  TASK_COMPLETED
}

enum ActivityDirection {
  INBOUND
  OUTBOUND
}

enum ActivityOutcome {
  NONE
  NO_ANSWER
  LEFT_VOICEMAIL
  SPOKE_TO_CONTACT
  MEETING_BOOKED
  INTERESTED
  NOT_INTERESTED
  CALL_BACK
  DO_NOT_CONTACT
}

model Activity {
  id          String             @id @default(cuid())
  leadId      String
  lead        Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?           @relation(fields: [contactId], references: [id], onDelete: SetNull)
  userId      String?
  user        User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  type        ActivityType
  direction   ActivityDirection  @default(OUTBOUND)
  outcome     ActivityOutcome    @default(NONE)
  subject     String?
  body        String?
  durationMin Int?
  occurredAt  DateTime           @default(now())
  createdAt   DateTime           @default(now())

  @@index([leadId, occurredAt])
  @@index([type])
  @@index([occurredAt])
}

// ------------------------------------------------------------------
// Tasks
// ------------------------------------------------------------------

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

model Task {
  id           String      @id @default(cuid())
  title        String
  description  String?
  dueAt        DateTime?
  reminderAt   DateTime?
  priority     Priority    @default(MEDIUM)
  status       TaskStatus  @default(OPEN)
  leadId       String?
  lead         Lead?       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactId    String?
  contact      Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedToId String?
  assignedTo   User?       @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  completedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([status, dueAt])
  @@index([leadId])
}

// ------------------------------------------------------------------
// Tags
// ------------------------------------------------------------------

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  color String    @default("#DC2626")
  leads LeadTag[]
}

model LeadTag {
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
}

// ------------------------------------------------------------------
// Campaigns & sequences
// ------------------------------------------------------------------

enum CampaignType {
  EMAIL
  CALL_BLITZ
  LINKEDIN
  DIRECT_MAIL
  MIXED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum CampaignLeadStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  CLICKED
  REPLIED
  BOUNCED
  UNSUBSCRIBED
  SKIPPED
}

model Campaign {
  id          String         @id @default(cuid())
  name        String
  type        CampaignType   @default(EMAIL)
  status      CampaignStatus @default(DRAFT)
  subject     String?
  bodyTemplate String?
  templateId  String?
  template    EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  leads CampaignLead[]
}

model CampaignLead {
  campaignId String
  campaign   Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId     String
  lead       Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status     CampaignLeadStatus @default(QUEUED)
  sentAt     DateTime?
  openedAt   DateTime?
  clickedAt  DateTime?
  repliedAt  DateTime?
  error      String?

  @@id([campaignId, leadId])
  @@index([leadId])
}

model EmailTemplate {
  id        String   @id @default(cuid())
  name      String
  category  String   @default("general")
  subject   String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns Campaign[]
}

enum SequenceStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

model Sequence {
  id          String         @id @default(cuid())
  name        String
  description String?
  status      SequenceStatus @default(DRAFT)
  isDefault   Boolean        @default(false) // auto-enrol new leads
  // steps: [{ order, delayDays, type: "EMAIL"|"CALL"|"TASK"|"LINKEDIN", subject?, templateId?, note? }]
  steps       Json
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  enrollments SequenceEnrollment[]
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  REPLIED
  UNSUBSCRIBED
}

model SequenceEnrollment {
  id         String           @id @default(cuid())
  sequenceId String
  sequence   Sequence         @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  leadId     String
  lead       Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  status     EnrollmentStatus @default(ACTIVE)
  currentStep Int             @default(0)
  nextRunAt  DateTime?
  enrolledAt DateTime         @default(now())
  completedAt DateTime?

  @@unique([sequenceId, leadId])
  @@index([status, nextRunAt])
}

// ------------------------------------------------------------------
// Lead discovery / imports
// ------------------------------------------------------------------

enum ImportSource {
  CQC
  COMPANIES_HOUSE
  CSV
  LINKEDIN_SALES_NAV
  WEB_SEARCH
  MANUAL
}

enum ImportStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

model ImportJob {
  id          String       @id @default(cuid())
  source      ImportSource
  status      ImportStatus @default(RUNNING)
  query       Json?
  totalFound  Int          @default(0)
  imported    Int          @default(0)
  duplicates  Int          @default(0)
  failed      Int          @default(0)
  errors      Json?
  createdById String?
  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  completedAt DateTime?

  leads ImportJobLead[]
}

model ImportJobLead {
  importJobId String
  importJob   ImportJob @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@id([importJobId, leadId])
}

model SavedSearch {
  id        String   @id @default(cuid())
  name      String
  source    ImportSource
  params    Json
  lastRunAt DateTime?
  createdAt DateTime @default(now())
}

// ------------------------------------------------------------------
// Generic key-value settings
// ------------------------------------------------------------------

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
